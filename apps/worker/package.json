{
  "name": "worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file=../../.env dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "preview": "bun run scripts/preview.ts"
  },
  "dependencies": {
    "@emojis-bot/db": "*",
    "@emojis-bot/logger": "*",
    "sharp": "^0.34.5",
    "zod": "^3.22.4",
    "telegraf": "^4.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "bun-types": "latest"
  }
}
