{
  "name": "bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts --outdir .elysia --target bun",
    "start": "bun --env-file=../../.env .elysia/index.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@emojis-bot/db": "*",
    "@emojis-bot/logger": "*",
    "elysia": "^1.1.0",
    "telegraf": "^4.15.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "bun-types": "latest"
  }
}
